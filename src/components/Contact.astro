    .konum:focus-visible {
      transform: translate(-50%, calc(-100% + 2px));
    }
  }
</style>

<script>
  /* ---- TALEP FORMU ----
     Progressive enhancement only: the form already posts and already answers
     without this file. What the script adds is staying on the page - and the
     campaign tags, which only the browser knows.

     WARNING: js=1 IS THE CONTRACT WITH THE SERVER. The route answers JSON when
     it sees it and a 303 redirect when it does not, so a visitor with a blocked
     script never lands on a page of raw JSON. */
  const form = document.querySelector<HTMLFormElement>('.form');

  if (form) {
    const jsAlan = form.querySelector<HTMLInputElement>('input[name="js"]');
    const utmAlan = form.querySelector<HTMLInputElement>('input[name="utm"]');
    const dugme = form.querySelector<HTMLButtonElement>('[data-gonder]');
    const durum = form.querySelector<HTMLParagraphElement>('.durum');
    if (jsAlan) jsAlan.value = '1';

    /* Which campaign brought them. Read once here because the server never sees
       the query string of the page the form sits on. */
    if (utmAlan) {
      const q = new URLSearchParams(location.search);
      const parcalar = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'fbclid']
        .map((k) => (q.get(k) ? `${k}=${q.get(k)}` : ''))
        .filter(Boolean);
      if (!parcalar.length && document.referrer) {
        try {
          const r = new URL(document.referrer);
          if (r.origin !== location.origin) parcalar.push(`ref=${r.hostname}`);
        } catch { /* bozuk referrer bir hata değil, yalnız bilinmeyen kaynaktır */ }
      }
      utmAlan.value = parcalar.join(' ').slice(0, 500);
    }

    const yaz = (metin: string, tur: 'ok' | 'hata') => {
      if (!durum) return;
      durum.textContent = metin;
      durum.dataset.tur = tur;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!dugme || dugme.disabled) return;
      const eski = dugme.textContent || '';
      dugme.disabled = true;
      dugme.textContent = dugme.dataset.bekle || eski;
      yaz('', 'ok');
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!r.ok) throw new Error(String(r.status));
        /* The form is cleared so a second enquiry starts empty - and so a
           refresh cannot resend the same one. */
        form.reset();
        if (jsAlan) jsAlan.value = '1';
        yaz(durum?.dataset.tamam || '', 'ok');
      } catch {
        yaz(durum?.dataset.hata || '', 'hata');
      } finally {
        dugme.disabled = false;
        dugme.textContent = eski;
      }
    });
  }
</script>

<script>
  /* The pin is anchored to the middle of the frame, so it is only honest while
     the map is where we left it. Panning happens in another origin and never
     reaches this document - the one thing we can see is the frame taking focus,
     which it does on the first click or drag inside it. Treat that as "the
     position is no longer mine" and fade the marker out; the provider's own pin
     and its directions card are still there.

     WARNING: CHECK WHAT TOOK FOCUS. window.blur also fires when the visitor
     switches tab or app, and hiding the pin for that would be wrong - only a
     click into the frame makes it the active element. */
  const harita = document.querySelector<HTMLElement>('.harita');
  const cerceve = harita?.querySelector('iframe');

  if (harita && cerceve) {
    window.addEventListener('blur', () => {
      if (document.activeElement === cerceve) harita.classList.add('oynatildi');
    });
  }
</script>
