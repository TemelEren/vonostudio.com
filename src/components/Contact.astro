  }

  .dugme-birincil:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .durum {
    font-size: 0.9rem;
    margin: 0;
  }

  .durum[data-tur='ok'] {
    color: var(--ink);
  }

  /* WARNING: OFF-SCREEN, NOT display:none. A field that is not rendered at all
     is skipped by some bots - and by some assistive technology, which is why it
     also carries a label and aria-hidden. */
  .tuzak {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 700px) {
