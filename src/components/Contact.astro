---
import { useTranslations, type Locale } from '../i18n/ui';
import { loadSettings } from '../db';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const settings = loadSettings();

const email = settings.email;
const phone = settings.phone;
const address = settings.address[locale];
const socials = settings.social.map((s) => ({ label: s.name, href: s.link }));

/* WARNING: THESE KEYS ARE NEWER THAN EVERY EXISTING DATABASE. Interface strings
   are a compile-time type taken from the seed, so t() is type-safe, but an
   installation that predates this section has no row for them and t() hands
   back the key itself - a button reading "contact.call". The editor's text wins
   the moment they add it (Web Sitesi -> Arayüz Metinleri); until then the
   visitor reads a word rather than an identifier. Same guard as projects.all. */
const metin = (key: Parameters<typeof t>[0], tr: string, en: string) => {
  const ham = t(key);
  return ham === key ? (locale === 'tr' ? tr : en) : ham;
};

const konu = metin('contact.mail.subject', 'Proje talebi', 'Project enquiry');
const govde = metin(
  'contact.mail.body',
  'Merhaba,\n\nBir proje için görüşmek istiyorum.\n\nProje türü: \nKonum: \nYaklaşık alan: \nBaşlangıç: \n\nTeşekkürler,',
  'Hello,\n\nI would like to talk about a project.\n\nProject type: \nLocation: \nApproximate area: \nStart: \n\nThank you,',
);

/* The mail link carries the subject and a short scaffold, so the visitor writes
   two lines instead of composing from nothing - that is the "quick shortcut"
   this block is for. Both are editable copy, not code: an office changes the
   wording of its own enquiries far more often than it changes its markup. */
const mailHref =
  `mailto:${email}?subject=${encodeURIComponent(konu)}&body=${encodeURIComponent(govde)}`;

/* WARNING: TWO DIFFERENT SHAPES OF THE SAME NUMBER. `tel:` keeps the plus and
   the digits; wa.me takes DIGITS ONLY and reads them as a full international
   number. */
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : '';
/* WARNING: NO COUNTRY CODE IS INVENTED. wa.me has no notion of "local number" -
   given 5550356655 it would ring someone in another country. A number that is
   not written in international form gets no WhatsApp link at all; the call
   link still works, and the editor fixes the number when they want the second
   button. */
const waRakam = phone.trim().startsWith('+') ? phone.replace(/\D/g, '') : '';
const waHref = waRakam
  ? `https://wa.me/${waRakam}?text=${encodeURIComponent(konu)}`
  : '';

/* Documented, cross-platform and keyless: the maps URL scheme opens the native
   app on a phone and the web map on a desktop. */
const yolHref = address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`
  : '';
/* One label for both places that open directions: the line under the address
   and the pin on the map. */
const yolEtiket = metin('contact.directions', 'Yol tarifi', 'Directions');

/* ---- Contact form ----
   The mail link answers "write to us"; the form answers "we will write to you",
   and only the second one leaves a record. Everything typed here reaches the
   ERP's inbox (Pazarlama → Potansiyel Müşteriler), so a website visit finally
   becomes something the office can measure and follow up. */
const f = {
  baslik: metin('contact.form.title', 'Ya da formu doldurun', 'Or fill in the form'),
  ad: metin('contact.form.name', 'Ad Soyad / Firma', 'Name / company'),
  eposta: metin('contact.form.email', 'E-posta', 'E-mail'),
  telefon: metin('contact.form.phone', 'Telefon (isteğe bağlı)', 'Phone (optional)'),
  mesaj: metin('contact.form.message', 'Projeniz hakkında kısaca', 'Briefly about your project'),
  ipucu: metin('contact.form.message.hint',
    'Proje türü, konum, yaklaşık alan ve başlangıç zamanı yazarsanız ilk dönüşümüz daha isabetli olur.',
    'Project type, location, approximate area and start date help us reply with something useful.'),
  onay: metin('contact.form.consent',
    'Aydınlatma metnini okudum; iletişim bilgilerimin talebimin değerlendirilmesi ve tarafıma dönüş yapılması amacıyla işlenmesini kabul ediyorum.',
    'I have read the privacy notice and consent to my contact details being processed so that my enquiry can be assessed and answered.'),
  aydinlatmaBaslik: metin('contact.form.privacy.title', 'Aydınlatma metni', 'Privacy notice'),
  /* ⚠ UZUN METNİN DE YEDEĞİ OLMAK ZORUNDA. İlk yazımda yedek boş bırakıldı
     ("tohumda zaten var") ve ölçüldü: mevcut veritabanında bu satır YOK, metin
     boş döndü ve <details> hiç çizilmedi — yani onay kutusu "aydınlatma
     metnini okudum" derken okunacak metin sayfada yoktu. Bir onayın dayanağı
     boş olamaz; metin panelden değiştirilebilir ama hiçbir zaman KAYIP olmaz. */
  aydinlatma: metin('contact.form.privacy',
    "6698 sayılı Kişisel Verilerin Korunması Kanunu uyarınca veri sorumlusu VONO MİMARLIK TASARIM İNŞAAT'tır. Bu formla ilettiğiniz ad, e-posta, telefon ve mesaj içeriği yalnızca talebinizin değerlendirilmesi, tarafınıza dönüş yapılması ve gerekmesi hâlinde teklif hazırlanması amacıyla işlenir. Verileriniz bu amaç dışında kullanılmaz, üçüncü kişilerle paylaşılmaz ve yurt dışına aktarılmaz; kendi sunucumuzda saklanır ve talebiniz sonuçlandıktan sonra makul süre içinde silinir. Bu onay yalnızca talebinize dönüş içindir; tanıtım ve kampanya iletisi göndermemiz için ayrıca izniniz istenir. Kanunun 11. maddesi kapsamındaki bilgi talep etme, düzeltme, silme ve itiraz haklarınızı yukarıdaki e-posta adresine yazarak kullanabilirsiniz.",
    'Under Turkish Personal Data Protection Law no. 6698 the data controller is VONO MIMARLIK TASARIM INSAAT. The name, e-mail, phone number and message you send through this form are processed solely to assess and answer your enquiry and, where relevant, to prepare a proposal. They are not used for any other purpose, not shared with third parties and not transferred abroad; they are kept on our own server and deleted within a reasonable time after your enquiry is closed. This consent covers our reply only; separate permission is asked before we send any promotional message. You may exercise your rights under article 11 of the law - information, correction, deletion and objection - by writing to the e-mail address above.'),
  gonder: metin('contact.form.submit', 'Talebi gönder', 'Send enquiry'),
  gonderiliyor: metin('contact.form.sending', 'Gönderiliyor…', 'Sending…'),
  tamam: metin('contact.form.ok',
    'Teşekkürler, talebiniz bize ulaştı. En kısa sürede dönüş yapacağız.',
    'Thank you, we have received your enquiry and will get back to you shortly.'),
  hata: metin('contact.form.error',
    'Talep gönderilemedi. Lütfen tekrar deneyin ya da doğrudan e-posta yazın.',
    'The enquiry could not be sent. Please try again or e-mail us directly.'),
};

/* Set by the no-JS path: the API route sends the visitor back with ?talep=ok
   (or =hata) and the message is rendered server-side, identical to the one the
   script shows in place. */
const talep = Astro.url.searchParams.get('talep');
/* WARNING: THE MAP IS DRIVEN BY THE ADDRESS, NOT BY COORDINATES. There are no
   coordinates in the content database and guessing a lat/lng would be inventing
   data that looks authoritative. This embed takes the address string that the
   editor already maintains - measured against the live address, it lands on
   Poligon Cd. Keyless, so nothing to configure and nothing to expire; if the
   pin ever drifts, the fix is the address field. */
const haritaSrc = address
  ? `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`
  : '';
---

<section class="section" id="iletisim">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 class="section-title">{t('contact.title')}</h2>
    </div>

    <a class="big-mail" href={mailHref} data-reveal>
      <span class="cta">{t('contact.cta')}</span>
      <span class="mail-satir">
        <span class="mail">{email}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" />
        </svg>
      </span>
    </a>

    <div class="cols">
      <div data-reveal>
        <h4>{t('contact.address.label')}</h4>
        {
          yolHref ? (
            <a class="adres" href={yolHref} target="_blank" rel="noopener noreferrer">
              <span>{address}</span>
              <span class="eylem">
                {yolEtiket}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </span>
            </a>
          ) : (
            <p>{address}</p>
          )
        }
      </div>
      <div data-reveal>
        <h4>{t('contact.phone.label')}</h4>
        <p class="tel">{phone}</p>
        <div class="dugmeler">
          {telHref && <a class="dugme" href={telHref}>{metin('contact.call', 'Ara', 'Call')}</a>}
          {
            waHref && (
              <a class="dugme" href={waHref} target="_blank" rel="noopener noreferrer">
                {metin('contact.whatsapp', 'WhatsApp', 'WhatsApp')}
              </a>
            )
          }
        </div>
      </div>
      <div data-reveal>
        <h4>{t('contact.social.label')}</h4>
        <ul>
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- ---- TALEP FORMU ----
         WARNING: THE FORM WORKS WITHOUT JAVASCRIPT. It is a plain POST to our
         own route; the script only upgrades it to stay on the page. Half the
         point of this block is measurement, and a form that silently fails for
         a visitor with a blocked script measures nothing. -->
    <div class="form-blok" data-reveal>
      <h3 class="cta">{f.baslik}</h3>
      <form class="form" method="post" action="/api/iletisim" novalidate>
        <!-- Honeypot: hidden from people, filled in by bots. Not `display:none`
             on purpose - some scripts skip those; this one is off-screen and
             out of the tab order. -->
        <p class="tuzak" aria-hidden="true">
          <label for="website">Bu alanı boş bırakın</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </p>
        <input type="hidden" name="sayfa" value={Astro.url.pathname} />
        <input type="hidden" name="utm" value="" />
        <input type="hidden" name="js" value="" />

        <div class="alanlar">
          <label class="alan">
            <span>{f.ad}</span>
            <input name="ad" type="text" autocomplete="name" maxlength="200" />
          </label>
          <label class="alan">
            <span>{f.eposta}</span>
            <input name="eposta" type="email" autocomplete="email" maxlength="320" required />
          </label>
          <label class="alan">
            <span>{f.telefon}</span>
            <input name="telefon" type="tel" autocomplete="tel" maxlength="40" />
          </label>
          <label class="alan alan-genis">
            <span>{f.mesaj}</span>
            <textarea name="mesaj" rows="4" maxlength="4000" required></textarea>
          </label>
        </div>
        <p class="ipucu">{f.ipucu}</p>

        <label class="onay">
          <input type="checkbox" name="onay" value="1" required />
          <span>{f.onay}</span>
        </label>
        {
          f.aydinlatma && (
            <details class="aydinlatma">
              <summary>{f.aydinlatmaBaslik}</summary>
              <p>{f.aydinlatma}</p>
            </details>
          )
        }

        <div class="gonder-satir">
          <button class="dugme dugme-birincil" type="submit" data-gonder data-bekle={f.gonderiliyor}>{f.gonder}</button>
          <p class="durum" role="status" aria-live="polite" data-tamam={f.tamam} data-hata={f.hata}>
            {talep === 'ok' ? f.tamam : talep === 'hata' ? f.hata : ''}
          </p>
        </div>
      </form>
    </div>
  </div>

  {
    haritaSrc && (
      <div class="harita" data-reveal>
        <iframe
          src={haritaSrc}
          title={metin('contact.map.title', 'Ofis konumu — harita', 'Office location — map')}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
        <a
          class="konum"
          href={yolHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={yolEtiket}
          title={yolEtiket}
        >
          <svg viewBox="0 0 28 40" aria-hidden="true">
            <path d="M14 40C6 26 1 22 1 14A13 13 0 1 1 27 14c0 8-5 12-13 26Z" />
            <circle cx="14" cy="14" r="5" />
          </svg>
        </a>
      </div>
    )
  }
</section>

<style>
  .big-mail {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: clamp(2rem, 5vw, 4rem);
    border-block: 1px solid var(--line);
    position: relative;
  }

  /* WARNING: ONE SIZE FOR ONE ROLE. Measured before: the small caps above the
     mail address were 12.8px and the column headings 12px - close enough that
     nobody would call it a hierarchy, far enough that the eye reads it as a
     wobble. They say the same kind of thing, so they are one token now
     (styles/global.css). */
  .cta,
  .cols h4 {
    font-family: var(--font-display);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mail {
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    word-break: break-all;
    background-image: linear-gradient(var(--ink), var(--ink));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: left 100%;
    transition: background-size 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .big-mail:hover .mail {
    background-size: 100% 2px;
  }

  /* The arrow belongs to the address, so the two wrap as one thing. Loose in
     the row it dropped to a line of its own on a phone (measured at 390px) and
     read as a stray mark rather than as "this opens something". */
  .mail-satir {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .arrow {
    width: clamp(1.4rem, 3vw, 2.4rem);
    height: auto;
    flex: none;
    transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .big-mail:hover .arrow {
    transform: translate(0.3rem, -0.3rem);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .cols h4 {
    margin-bottom: 0.8rem;
  }

  .cols ul {
    list-style: none;
  }

  .cols li a {
    display: inline-block;
    padding-block: 0.15rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .cols li a:hover {
    border-color: var(--ink);
  }

  /* The address IS the link - a separate "open in maps" line underneath would
     make the reader choose between two things that go to the same place. */
  .adres {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .adres > span:first-child {
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .adres:hover > span:first-child {
    border-color: var(--ink);
  }

  .eylem {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .eylem svg {
    width: 0.85em;
    height: 0.85em;
    transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .adres:hover .eylem svg {
    transform: translate(0.15rem, -0.15rem);
  }

  /* The number stays plain text and the two buttons carry the actions: the
     visitor is asked which one they want rather than having the page decide
     that tapping a phone number means placing a call. */
  .tel {
    font-variant-numeric: tabular-nums;
  }

  .dugmeler {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  /* 44px is the floor a finger needs; at this type size the box came out 39px
     tall, so the height is stated rather than left to the font's metrics. */
  .dugme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--line);
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .dugme:hover,
  .dugme:focus-visible {
    border-color: var(--ink);
  }

  /* WARNING: BLACK AND WHITE IS A FILTER, NOT A MAP STYLE. A styled tile layer
     needs an API key and a billing account; `grayscale` costs nothing, works on
     whatever the provider draws, and cannot fall out of date. The contrast nudge
     is there because a desaturated road map goes flat.

     Full-bleed on purpose: it sits outside .container so it reads as the ground
     the page ends on rather than one more card in the column. `lazy` keeps the
     third-party frame - and its cookies - out of the page until the visitor has
     scrolled this far. */
  .harita {
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--soft);
    line-height: 0;
    position: relative;
  }

  .harita iframe {
    width: 100%;
    height: clamp(18rem, 38vh, 30rem);
    border: 0;
    display: block;
    filter: grayscale(1) contrast(1.05);
  }

  /* WARNING: THE FILTER IS ON THE FRAME, THE PIN IS OUTSIDE IT. That is the
     whole trick: the map desaturates and the marker keeps its colour, which
     cannot be done from here to the provider's own pin - the frame is another
     origin and nothing in it can be styled or clicked through.

     So the pin is ours, drawn on top of theirs and linking to the same
     directions URL as the address above. Measured on the live embed: the
     provider anchors its marker at the exact centre of the frame and draws it
     27x37px; this one is 32x45.7 with its point at the same spot, so the grey
     one is covered rather than doubled. The 2px nudge covers the soft shadow
     under their point. Re-measure both boxes before changing either number. */
  .konum {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    transform: translate(-50%, calc(-100% + 2px));
    transform-origin: bottom center;
    transition:
      transform 0.3s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.3s ease;
  }

  /* A finger needs ~44px and the pin is 32 wide; the hit area is grown around
     it instead of the drawing, so the point stays where the address is. */
  .konum::before {
    content: '';
    position: absolute;
    inset: -6px -8px -10px;
  }

  .konum svg {
    display: block;
    width: 32px;
    height: auto;
    /* The stroke dilates the silhouette by ~1px so it stays a superset of the
       grey pin under it; without this the tail is a hair narrower than theirs
       and a sliver shows. It paints outside the viewBox, which an SVG clips by
       default. */
    overflow: visible;
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.3));
  }

  /* THE ONLY COLOUR ON AN OTHERWISE MONOCHROME PAGE, and deliberately so - it
     is what makes the marker read as "you are here" against a grey map. It is
     not part of the theme palette (db/theme.ts carries five neutrals), so this
     line is the one place to change it. */
  .konum path {
    fill: #e0301e;
    stroke: #e0301e;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .konum circle {
    fill: #fff;
  }

  .konum:hover,
  .konum:focus-visible {
    transform: translate(-50%, calc(-100% + 2px)) scale(1.08);
  }

  .konum:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  /* WARNING: ONCE THE MAP HAS BEEN DRAGGED THE PIN IS A LIE. Our marker is
     pinned to the centre of the frame; theirs moves with the map. Panning
     happens inside another origin, so the only signal we get is that the frame
     took focus - which it does on any click or drag inside it. From that moment
     the position is no longer ours to guarantee, so the pin steps aside and
     leaves the provider's own marker and its directions card in charge.
     (Measured: the wheel scrolls the page here, it does not zoom the map, so
     scrolling never desyncs anything.) */
  .harita.oynatildi .konum {
    opacity: 0;
    pointer-events: none;
  }


  /* ---- TALEP FORMU ----
     The section already carries a form-ish rhythm (labels in small caps, thin
     rules); the form borrows it rather than introducing a second style. */
  .form-blok {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .form-blok > h3 {
    margin-bottom: 1.2rem;
  }

  .alanlar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem 1.5rem;
  }

  .alan-genis {
    grid-column: 1 / -1;
  }

  .alan {
    display: grid;
    gap: 0.4rem;
  }

  .alan > span {
    font-family: var(--font-display);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Underline only: a boxed field would read as a component from another site.
     The focus ring is the ink line thickening - visible without colour, which
     is the one signal that survives every kind of colour blindness. */
  .alan input,
  .alan textarea {
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0.5rem 0;
    min-height: 2.75rem;
    transition: border-color 0.25s ease;
  }

  .alan textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .alan input:focus,
  .alan textarea:focus {
    outline: none;
    border-bottom-color: var(--ink);
    border-bottom-width: 2px;
    padding-bottom: calc(0.5rem - 1px);
  }

  .ipucu {
    margin-top: 0.7rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .onay {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin-top: 1.6rem;
    font-size: 0.9rem;
    line-height: 1.6;
    cursor: pointer;
  }

  .onay input {
    margin-top: 0.28rem;
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    accent-color: var(--ink);
  }

  .aydinlatma {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .aydinlatma summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .aydinlatma p {
    margin-top: 0.6rem;
    line-height: 1.7;
    max-width: 70ch;
  }

  .gonder-satir {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }

  .dugme-birincil {
