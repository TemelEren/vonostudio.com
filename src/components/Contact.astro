---
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { loadInstagram, loadSettings } from '../db';
import { paragraphs } from '../i18n/plainText';
import { POLICY_PATH } from '../consent/cookies';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const settings = loadSettings();

const email = settings.email;
const phone = settings.phone;
const address = settings.address[locale];

/* WARNING: THESE KEYS ARE NEWER THAN EVERY EXISTING DATABASE. Interface strings
   are a compile-time type taken from the seed, so t() is type-safe, but an
   installation that predates this section has no row for them and t() hands
   back the key itself - a button reading "contact.call". The editor's text wins
   the moment they add it (Web Sitesi -> Arayüz Metinleri); until then the
   visitor reads a word rather than an identifier. Same guard as projects.all. */
const metin = (key: Parameters<typeof t>[0], tr: string, en: string) => {
  const ham = t(key);
  return ham === key ? (locale === 'tr' ? tr : en) : ham;
};

const konu = metin('contact.mail.subject', 'Proje talebi', 'Project enquiry');
const govde = metin(
  'contact.mail.body',
  'Merhaba,\n\nBir proje için görüşmek istiyorum.\n\nProje türü: \nKonum: \nYaklaşık alan: \nBaşlangıç: \n\nTeşekkürler,',
  'Hello,\n\nI would like to talk about a project.\n\nProject type: \nLocation: \nApproximate area: \nStart: \n\nThank you,',
);

/* The mail link carries the subject and a short scaffold, so the visitor writes
   two lines instead of composing from nothing - that is the "quick shortcut"
   this block is for. Both are editable copy, not code: an office changes the
   wording of its own enquiries far more often than it changes its markup. */
/* A subject or body switched off (§5.231) is left out of the link rather than
   sent as an empty parameter. */
const mailQuery = [
  konu ? `subject=${encodeURIComponent(konu)}` : '',
  govde ? `body=${encodeURIComponent(govde)}` : '',
].filter(Boolean).join('&');
const mailHref = `mailto:${email}${mailQuery ? `?${mailQuery}` : ''}`;

/* WARNING: THE LABEL SAYS WHAT THE THING IS, NOT AN INVITATION (editor,
   2026-09-12: "next to the mail it says 'let's talk', it should say e-mail").
   The old `contact.cta` ("Konuşalım") sat above the address as a slogan; next to
   a phone block labelled "Telefon" it read as a mismatched pair. */
const epostaEtiket = metin('contact.email.label', 'E-posta', 'E-mail');

/* ---- The note under the mail address (editor, 2026-09-13) ----
   Internship/job applications and brand collaborations, in the editor's words,
   editable from the panel (Web Sitesi -> Arayüz Metinleri -> contact.email.note).

   The value is PLAIN TEXT with line breaks, not HTML: the panel is a text box
   and nothing typed there should be able to put markup on the page. A blank
   line starts a new paragraph; inside a paragraph the first line is its lead
   ("Staj ve iş başvuruları için,") when more lines follow.

   WARNING: A LEAD LEFT ON ITS OWN IS STILL A LEAD. Written the natural way -
   "…için," then an empty line then the sentence - the lead would be a one-line
   paragraph of its own; a single line ending in a comma or colon is joined to
   the paragraph after it.

   Mail addresses in the text become mailto links: the note says "send it to
   info@…", and a visitor on a phone should be able to tap it. The parsing is
   shared with the cookie policy page (i18n/plainText.ts). */
const notMetni = metin(
  'contact.email.note',
  'Staj ve iş başvuruları için,\n20 MB’ı geçmeyen PDF formatındaki CV ve portfolyo dosyalarınızı info@vonostudio.com adresine gönderebilirsiniz.\n\nMarka iş birlikleri için,\nÜrünlerinize ait fiziksel kartela ve numuneleri adresimize kargolayabilirsiniz. Dijital kataloglarınızı info@vonostudio.com adresine ileterek randevu talep edebilirsiniz.',
  'For internships and job applications,\nplease send your CV and portfolio as PDF files of no more than 20 MB to info@vonostudio.com.\n\nFor brand collaborations,\nyou can ship physical swatches and samples of your products to our address. You can also send your digital catalogues to info@vonostudio.com to request an appointment.',
);
const notlar = paragraphs(notMetni);

/* WARNING: TWO DIFFERENT SHAPES OF THE SAME NUMBER. `tel:` keeps the plus and
   the digits; wa.me takes DIGITS ONLY and reads them as a full international
   number. */
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : '';
/* WARNING: NO COUNTRY CODE IS INVENTED. wa.me has no notion of "local number" -
   given 5550356655 it would ring someone in another country. A number that is
   not written in international form gets no WhatsApp link at all; the call
   link still works, and the editor fixes the number when they want the second
   button. */
const waRakam = phone.trim().startsWith('+') ? phone.replace(/\D/g, '') : '';
const waHref = waRakam
  ? `https://wa.me/${waRakam}${konu ? `?text=${encodeURIComponent(konu)}` : ''}`
  : '';

/* Documented, cross-platform and keyless: the maps URL scheme opens the native
   app on a phone and the web map on a desktop. */
const yolHref = address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`
  : '';
/* One label for both places that open directions: the line under the address
   and the pin on the map. */
const yolEtiket = metin('contact.directions', 'Yol tarifi', 'Directions');
/* Switched off (§5.231), the visible "Directions" text goes, but the map pin
   still needs an accessible name - it keeps the built-in one. */
const yolAdi = yolEtiket || (locale === 'tr' ? 'Yol tarifi' : 'Directions');
const cagriEtiket = metin('contact.call', 'Ara', 'Call');
const waEtiket = metin('contact.whatsapp', 'WhatsApp', 'WhatsApp');

/* ---- Social: a black-and-white mark per platform ----
   Glyphs from Simple Icons (CC0), one 24x24 path each, painted with
   `currentColor` so they follow the theme's ink instead of the brands' colours
   - the editor asked for monochrome icons, and the page carries one colour
   already (the map pin, §5.193).

   WARNING: THE PLATFORM IS RECOGNISED, NOT ASSUMED. The editor types a name and
   a link; the link's host decides first (a profile renamed "Instagram hesabı"
   still points at instagram.com), the name second. A platform not in this list
   is NOT given a lookalike glyph - it keeps its written name, because a wrong
   logo sends the visitor somewhere they did not expect. */
const IKON: Record<string, string> = {
