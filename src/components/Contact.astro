/* Host first, then the typed name. `x` is matched only as a whole host or name:
   as a substring it is inside half the words there are. */
const HOST: [RegExp, string][] = [
  [/(^|\.)instagram\.com$/, 'instagram'],
  [/(^|\.)linkedin\.com$/, 'linkedin'],
  [/(^|\.)pinterest\.[a-z.]+$/, 'pinterest'],
  [/(^|\.)(facebook\.com|fb\.com)$/, 'facebook'],
  [/(^|\.)(x\.com|twitter\.com)$/, 'x'],
  [/(^|\.)(youtube\.com|youtu\.be)$/, 'youtube'],
  [/(^|\.)behance\.net$/, 'behance'],
  [/(^|\.)tiktok\.com$/, 'tiktok'],
  [/(^|\.)(wa\.me|whatsapp\.com)$/, 'whatsapp'],
];
const platform = (name: string, link: string): string => {
  let host = '';
  try {
    host = new URL(link).hostname.toLowerCase();
  } catch {
    /* a malformed link is not a platform; the name may still be */
  }
  for (const [re, key] of HOST) if (host && re.test(host)) return key;
  const ad = (name || '').trim().toLowerCase();
  if (ad === 'x' || ad === 'twitter') return 'x';
  return Object.keys(IKON).find((k) => k !== 'x' && ad.includes(k)) || '';
};
const socials = settings.social.map((s) => {
  const key = platform(s.name, s.link);
  return { label: s.name, href: s.link, path: key ? IKON[key] : '' };
});

/* ---- Instagram strip (§5.221) ----
   The editor picks the posts in the panel (Web Sitesi → Instagram): an
   uploaded film or picture plus the post's link. No row, or an empty one,
   draws nothing - the section ends at the map exactly as before.

   The handle beside the label comes from the Instagram account already listed
   under social - typed once, not twice. */
const insta = loadInstagram();
const instaEtiket = metin('contact.instagram.label', 'Instagram', 'Instagram');
const instaHesap = (() => {
  const s = settings.social.find((x) => platform(x.name, x.link) === 'instagram');
  if (!s) return null;
  try {
    const seg = new URL(s.link).pathname.split('/').filter(Boolean)[0];
    return seg ? { href: s.link, ad: '@' + seg } : null;
  } catch {
    return null;
  }
})();

/* WARNING: THE MAP IS DRIVEN BY THE ADDRESS, NOT BY COORDINATES. There are no
   coordinates in the content database and guessing a lat/lng would be inventing
   data that looks authoritative. This embed takes the address string that the
   editor already maintains - measured against the live address, it lands on
   Poligon Cd. Keyless, so nothing to configure and nothing to expire; if the
   pin ever drifts, the fix is the address field. */
const haritaSrc = address
  ? `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`
  : '';

/* ---- The map waits for consent (§5.226) ----
   WARNING: THE IFRAME IS NOT IN THE PAGE UNTIL THE VISITOR SAYS YES. Google's
   embed sets Google's cookies the moment it loads, and a third-party cookie
   needs consent (KVKK cookie guideline). `loading="lazy"` only postponed that
   until the visitor scrolled here - it never asked. The frame now sits in a
   <template>, which the browser parses but does not load; the consent script
   (CookieConsent.astro) clones it in once the "external" category is granted.
   Until then the block explains why it is empty and offers the two ways on:
   load the map (which records the permission) or open directions on Google's
   own site, which sets nothing on this page. Without JavaScript the template
   never runs and the visitor gets the same explanation and link. */
const haritaIzinMetni = metin(
  'cookie.map.blocked',
  'Harita Google tarafından sunulur ve Google’ın çerezlerini yerleştirir. Görmek için izin verin.',
  'The map is served by Google and sets Google’s cookies. Allow it to see the map.',
);
const haritaYukleEtiket = metin('cookie.map.load', 'Haritayı yükle', 'Load the map');
const politikaHref = localePath(locale, POLICY_PATH[locale]);
---

<section class="section" id="iletisim">
  <div class="container">
    {t('contact.title') && (
      <div class="section-head" data-reveal>
        <h2 class="section-title">{t('contact.title')}</h2>
      </div>
    )}

    {/* WARNING: THE FORM IS GONE (editor, 2026-09-12: "you can remove the
        contact form"). Mail and phone now sit side by side as the two direct
        ways in, at the same size. The site's /api/iletisim route and the ERP
        inbox are left in place - nothing posts to them from this page any
        more, so the "Web talepleri" inbox will stay empty until a form comes
        back. */}
    <div class="ust">
      <div data-reveal>
        {epostaEtiket && <h4>{epostaEtiket}</h4>}
        <a class="big-mail" href={mailHref}>
          <span class="mail">{email}</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
        {
          notlar.length > 0 && (
            <div class="not">
              {notlar.map((n) => (
                <p>
                  {/* WARNING: NO JSX IN THE FRONTMATTER - Astro compiles it as
                      plain TypeScript and the page fails to render ("Expected >");
                      `astro check` did not catch it. The pieces are drawn here. */}
                  {n.lead.length > 0 && (
                    <span class="lead">{n.lead.map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}</span>
                  )}
                  {n.lines.map((satir) => (
                    <span class="satir">{satir.map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}</span>
                  ))}
                </p>
              ))}
            </div>
          )
        }
      </div>
      <div data-reveal>
        {t('contact.phone.label') && <h4>{t('contact.phone.label')}</h4>}
        {/* The number is large like the mail but stays plain text: the two
            buttons carry the actions, so the visitor chooses call or WhatsApp
            rather than having the page decide what a tap on it means. */}
        <p class="tel">{phone}</p>
        <div class="dugmeler">
          {telHref && cagriEtiket && <a class="dugme" href={telHref}>{cagriEtiket}</a>}
          {
            waHref && waEtiket && (
              <a class="dugme" href={waHref} target="_blank" rel="noopener noreferrer">
                {waEtiket}
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="cols">
      <div data-reveal>
        {t('contact.address.label') && <h4>{t('contact.address.label')}</h4>}
        {
          yolHref ? (
            <a class="adres" href={yolHref} target="_blank" rel="noopener noreferrer">
              <span>{address}</span>
              <span class="eylem" hidden={!yolEtiket}>
                {yolEtiket}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </span>
            </a>
          ) : (
            <p>{address}</p>
          )
        }
      </div>
      <div data-reveal>
        {t('contact.social.label') && <h4>{t('contact.social.label')}</h4>}
        <ul class="sosyal">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.path && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={s.path} />
                    </svg>
                  )}
                  <span class="ad">{s.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  {
    haritaSrc && (
      <div class="harita" data-reveal data-consent="external">
        <template class="harita-cerceve">
          <iframe
            src={haritaSrc}
            title={metin('contact.map.title', 'Ofis konumu — harita', 'Office location — map')}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </template>
        <div class="harita-izin">
          <p>{haritaIzinMetni}</p>
          <div class="harita-izin-dugmeler">
            <button type="button" class="dugme" data-consent-accept>{haritaYukleEtiket}</button>
            {yolEtiket && <a class="dugme" href={yolHref} target="_blank" rel="noopener noreferrer">{yolEtiket}</a>}
            <a class="harita-izin-politika" href={politikaHref}>{metin('cookie.policy.title', 'Çerez Politikası', 'Cookie Policy')}</a>
          </div>
        </div>
        <a
          class="konum"
          href={yolHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={yolAdi}
          title={yolAdi}
        >
          <svg viewBox="0 0 28 40" aria-hidden="true">
            <path d="M14 40C6 26 1 22 1 14A13 13 0 1 1 27 14c0 8-5 12-13 26Z" />
            <circle cx="14" cy="14" r="5" />
          </svg>
        </a>
      </div>
    )
  }

  {/* ---- INSTAGRAM STRIP (§5.221) ----
      Under the map, full bleed like it. Grey until the pointer is on a tile,
      films silent and playing only while on screen. A tile without a link is
      a picture, not a dead link. */}
  {
    insta.length > 0 && (
      <div class="insta" data-reveal>
        <div class="container insta-bas">
          {instaEtiket && <h4>{instaEtiket}</h4>}
          {instaHesap && (
            <a class="insta-hesap" href={instaHesap.href} target="_blank" rel="noopener noreferrer">
              {instaHesap.ad}
            </a>
          )}
        </div>
        <ul class="insta-serit">
          {insta.map((m, i) => {
            const ad = `${instaEtiket || 'Instagram'} — ${i + 1}`;
            const icerik =
              m.kind === 'video' ? (
                <video
                  src={m.src}
                  poster={m.poster || undefined}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  disablepictureinpicture
                  aria-hidden="true"
                />
              ) : (
                <img src={m.src} alt="" loading="lazy" decoding="async" />
              );
            /* WARNING: A TILE WITHOUT ITS OWN POST LINK OPENS THE ACCOUNT (editor,
               2026-09-13: "clicking an Instagram video should open the Instagram
               link, once, in a new tab"). Measured: the tile with a link opened
               exactly one tab; the two without one did nothing, which reads as a
               broken site. The account comes from the social links, typed once
               (same source as the handle above). No account either -> still
               not a link: a tile pointing nowhere would be worse. Panel rule:
               lib/siteIcerik.js -> instagramHedef. */
            const hedef = m.link || instaHesap?.href || '';
            return (
              <li>
                {hedef ? (
                  <a class="insta-oge" href={hedef} target="_blank" rel="noopener noreferrer" aria-label={ad}>
                    {icerik}
                  </a>
                ) : (
                  <div class="insta-oge" role="img" aria-label={ad}>
                    {icerik}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>

<style>
  .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Two pairs, one grid shape: mail beside phone, address beside social. The
     columns line up between the rows, so the page reads as one table of ways
     to reach the office rather than as two unrelated blocks. */
  .ust,
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem clamp(2rem, 5vw, 4rem);
  }

  .cols {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* WARNING: ONE SIZE FOR ONE ROLE. Measured before: the small caps above the
     mail address were 12.8px and the column headings 12px - close enough that
     nobody would call it a hierarchy, far enough that the eye reads it as a
     wobble. They say the same kind of thing, so they are one token now
     (styles/global.css). */
  .ust h4,
  .cols h4 {
    font-family: var(--font-display);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }

  .big-mail {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    max-width: 100%;
  }

  /* Mail and number share one size so neither reads as the "real" contact. */
  .mail,
  .tel {
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .mail {
    word-break: break-all;
    background-image: linear-gradient(var(--ink), var(--ink));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: left 100%;
    transition: background-size 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .big-mail:hover .mail {
    background-size: 100% 2px;
  }

  /* The note reads as small print under the address it refers to - body face,
     quiet colour, a measure short enough to read in one sweep. The lead is the
     only line in ink, so the two audiences find their paragraph at a glance. */
  .not {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 38rem;
    display: grid;
    gap: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .not .lead,
  .not .satir {
    display: block;
  }

  .not .lead {
    color: var(--ink);
    font-weight: 500;
  }

  .not a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    word-break: break-word;
  }

  .not a:hover {
    text-decoration-thickness: 2px;
  }

  .arrow {
    width: clamp(1.2rem, 2.2vw, 1.8rem);
    height: auto;
    flex: none;
    transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .big-mail:hover .arrow {
    transform: translate(0.3rem, -0.3rem);
  }

  .tel {
    font-variant-numeric: tabular-nums;
  }

  /* The address IS the link - a separate "open in maps" line underneath would
     make the reader choose between two things that go to the same place. */
  .adres {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .adres > span:first-child {
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .adres:hover > span:first-child {
    border-color: var(--ink);
  }

  .eylem {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .eylem svg {
    width: 0.85em;
    height: 0.85em;
    transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .adres:hover .eylem svg {
    transform: translate(0.15rem, -0.15rem);
  }

  .dugmeler {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  /* 44px is the floor a finger needs; at this type size the box came out 39px
     tall, so the height is stated rather than left to the font's metrics. */
  .dugme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--line);
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .dugme:hover,
  .dugme:focus-visible {
    border-color: var(--ink);
  }

  /* ---- social accounts ----
     A black mark AND the platform's name (editor, 2026-09-12: "the platform
     names could be written next to the icons"). Icons alone asked the visitor
     to recognise three logos; the name removes the guess and is the link's
     accessible name. The mark stays ink, never the brand colour; a platform
     without a known mark shows its name alone (§5.219). The row is the target,
     44px tall. Hover fades, the same signal the menu uses (§5.213). */
  .sosyal {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(1.25rem, 2.5vw, 2rem);
  }

  .sosyal a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    color: var(--ink);
    transition: opacity 0.25s ease;
  }

  .sosyal a:hover {
    opacity: 0.6;
  }

  .sosyal a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .sosyal svg {
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
    fill: currentColor;
  }

  /* WARNING: BLACK AND WHITE IS A FILTER, NOT A MAP STYLE. A styled tile layer
     needs an API key and a billing account; `grayscale` costs nothing, works on
     whatever the provider draws, and cannot fall out of date. The contrast nudge
     is there because a desaturated road map goes flat.

     Full-bleed on purpose: it sits outside .container so it reads as the ground
     the page ends on rather than one more card in the column. `lazy` keeps the
     third-party frame - and its cookies - out of the page until the visitor has
     scrolled this far. */
  .harita {
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--soft);
    line-height: 0;
    position: relative;
  }

  /* Until consent: a quiet block the height of the map, so the page does not
     jump when the frame arrives. The pin is ours and would point at nothing. */
  .harita-izin {
    height: clamp(18rem, 38vh, 30rem);
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.1rem;
    padding: 2rem var(--pad);
    text-align: center;
    line-height: 1.6;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .harita-izin p {
    max-width: 34rem;
  }

  .harita-izin-dugmeler {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem 0.8rem;
  }

  .harita-izin-politika {
    font-size: var(--t-label);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .harita:not(.yuklendi) .konum {
    display: none;
  }

  .harita.yuklendi .harita-izin {
    display: none;
  }

  .harita iframe {
    width: 100%;
    height: clamp(18rem, 38vh, 30rem);
    border: 0;
    display: block;
    filter: grayscale(1) contrast(1.05);
  }

  /* WARNING: THE FILTER IS ON THE FRAME, THE PIN IS OUTSIDE IT. That is the
     whole trick: the map desaturates and the marker keeps its colour, which
     cannot be done from here to the provider's own pin - the frame is another
     origin and nothing in it can be styled or clicked through.

     So the pin is ours, drawn on top of theirs and linking to the same
     directions URL as the address above. Measured on the live embed: the
     provider anchors its marker at the exact centre of the frame and draws it
     27x37px; this one is 32x45.7 with its point at the same spot, so the grey
     one is covered rather than doubled. The 2px nudge covers the soft shadow
     under their point. Re-measure both boxes before changing either number. */
  .konum {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    transform: translate(-50%, calc(-100% + 2px));
    transform-origin: bottom center;
    transition:
      transform 0.3s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.3s ease;
  }

  /* A finger needs ~44px and the pin is 32 wide; the hit area is grown around
     it instead of the drawing, so the point stays where the address is. */
  .konum::before {
    content: '';
    position: absolute;
    inset: -6px -8px -10px;
  }

  .konum svg {
    display: block;
    width: 32px;
    height: auto;
    /* The stroke dilates the silhouette by ~1px so it stays a superset of the
       grey pin under it; without this the tail is a hair narrower than theirs
       and a sliver shows. It paints outside the viewBox, which an SVG clips by
       default. */
    overflow: visible;
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.3));
  }

  /* THE ONLY COLOUR ON AN OTHERWISE MONOCHROME PAGE, and deliberately so - it
     is what makes the marker read as "you are here" against a grey map. It is
     not part of the theme palette (db/theme.ts carries five neutrals), so this
     line is the one place to change it. */
  .konum path {
    fill: #e0301e;
    stroke: #e0301e;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .konum circle {
    fill: #fff;
  }

  .konum:hover,
  .konum:focus-visible {
    transform: translate(-50%, calc(-100% + 2px)) scale(1.08);
  }

  .konum:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  /* WARNING: ONCE THE MAP HAS BEEN DRAGGED THE PIN IS A LIE. Our marker is
     pinned to the centre of the frame; theirs moves with the map. Panning
     happens inside another origin, so the only signal we get is that the frame
     took focus - which it does on any click or drag inside it. From that moment
     the position is no longer ours to guarantee, so the pin steps aside and
     leaves the provider's own marker and its directions card in charge.
     (Measured: the wheel scrolls the page here, it does not zoom the map, so
     scrolling never desyncs anything.) */
  .harita.oynatildi .konum {
    opacity: 0;
    pointer-events: none;
  }

  /* ---- INSTAGRAM STRIP (§5.221) ----
     Grey is a FILTER on the media, not a property of the files: the editor
     uploads the post as it is, and the colour comes back the moment the
     pointer is on it. Tiles are portrait (9:16, the shape reels are shot in)
     and the row scrolls sideways when it outgrows the page. */
  .insta {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .insta-bas {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .insta-bas h4 {
    font-family: var(--font-display);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .insta-hesap {
    font-family: var(--font-display);
    font-size: var(--t-label);
    letter-spacing: 0.08em;
    color: var(--ink);
    transition: opacity 0.25s ease;
  }

  .insta-hesap:hover {
    opacity: 0.6;
  }

  .insta-serit {
    list-style: none;
    display: flex;
    gap: clamp(0.4rem, 0.8vw, 0.75rem);
    overflow-x: auto;
    padding-inline: var(--pad);
    padding-bottom: 0.5rem;
    scroll-snap-type: x proximity;
    /* WARNING: SNAPPING IGNORES PADDING UNLESS TOLD. Measured without this: the
       browser snapped the first tile flush to the screen edge on load (x=0 at
       390px, x=14 at 1440px) instead of on the page margin like everything
       above it. */
    scroll-padding-inline: var(--pad);
    scrollbar-width: thin;
  }

  .insta-serit li {
    flex: 0 0 clamp(9.5rem, 15vw, 13.5rem);
    scroll-snap-align: start;
  }

  .insta-oge {
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--soft);
  }

  .insta-oge img,
  .insta-oge video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.45s ease;
  }

  /* Hover only where there is a pointer: a tap on a phone would otherwise
     leave one tile stuck in colour. */
  @media (hover: hover) {
    .insta-oge:hover img,
    .insta-oge:hover video {
      filter: none;
    }
  }

  .insta-oge:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .insta-oge:focus-visible img,
  .insta-oge:focus-visible video {
    filter: none;
  }

  @media (max-width: 700px) {
    .ust,
    .cols {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mail,
    .arrow,
    .eylem svg,
    .dugme,
    .sosyal a,
    .insta-oge img,
    .insta-oge video,
    .adres > span:first-child {
      transition: none;
    }

    .konum {
      transition: none;
    }

    .big-mail:hover .arrow,
    .adres:hover .eylem svg {
      transform: none;
    }

    .konum:hover,
    .konum:focus-visible {
      transform: translate(-50%, calc(-100% + 2px));
    }
  }
</style>

<script>
  /* The pin is anchored to the middle of the frame, so it is only honest while
     the map is where we left it. Panning happens in another origin and never
     reaches this document - the one thing we can see is the frame taking focus,
     which it does on the first click or drag inside it. Treat that as "the
     position is no longer mine" and fade the marker out; the provider's own pin
     and its directions card are still there.

     WARNING: CHECK WHAT TOOK FOCUS. window.blur also fires when the visitor
     switches tab or app, and hiding the pin for that would be wrong - only a
     click into the frame makes it the active element. */
  const harita = document.querySelector<HTMLElement>('.harita');

  /* The frame is cloned in only after consent (§5.226), so it is looked up at
     the moment of the blur, not once at load. */
  if (harita) {
    window.addEventListener('blur', () => {
      const cerceve = harita.querySelector('iframe');
      if (cerceve && document.activeElement === cerceve) harita.classList.add('oynatildi');
    });
  }
</script>

<script>
  /* ---- INSTAGRAM STRIP ----
     WARNING: NOT `autoplay`. Twenty-four tiles would mean twenty-four decoders
     and downloads running below the fold. A film plays while it is on screen
     and stops when it leaves (same rule as the project films, §5.191); someone
     who asked the system for less motion gets still frames. */
  const instaFilmler = Array.from(document.querySelectorAll<HTMLVideoElement>('.insta video'));

  if (instaFilmler.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const izleyici = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const film = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) film.play().catch(() => {});
          else film.pause();
        }
      },
      { threshold: 0.3 }
    );
    for (const film of instaFilmler) izleyici.observe(film);
  }
</script>
