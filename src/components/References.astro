---
import { useTranslations, type Locale } from '../i18n/ui';
import { loadReferences } from '../db';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const references = loadReferences();
---

<section class="section" id="referanslar">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 class="section-title">{t('references.title')}</h2>
    </div>
  </div>

  <div class="marquee" data-reveal>
    <!-- The list is rendered four times (two per animation half): the
         animation slides exactly half the track, so the loop is seamless
         and the strip stays filled even with few logos. -->
    <div class="track">
      {
        [0, 1, 2, 3].map((copy) => (
          <div class="group" aria-hidden={copy === 0 ? undefined : 'true'}>
            {references.map((ref) => (
              <img src={ref.logo} alt={copy === 0 ? ref.name : ''} loading="lazy" decoding="async" />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* A little air between the heading and the strip, so the heading reads as
     the strip's label rather than touching the logos. */
  .section-head {
    margin-bottom: clamp(0.5rem, 1vw, 1rem);
  }

  /* No rules above and below the strip: the page carries no divider lines
     (styles/global.css). */
  .marquee {
    overflow: hidden;
    padding-block: 2.25rem;
    /* Fade the strip out toward both edges. */
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .group {
    display: flex;
    align-items: center;
    gap: clamp(3.5rem, 7vw, 6.5rem);
    padding-right: clamp(3.5rem, 7vw, 6.5rem);
  }

  /* Larger marks (editor, 2026-09-12: "the logos could be bigger"): 2.6rem
     read as a row of favicons under a portfolio of full-width photographs. */
  .group img {
    height: clamp(3rem, 4.4vw, 4.5rem);
    width: auto;
    opacity: 0.55;
    filter: grayscale(1);
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  .group img:hover {
    opacity: 1;
    filter: grayscale(0);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
    }

    .group[aria-hidden] {
      display: none;
    }
  }
</style>
