    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transform: scale(0.97);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .full.is-open img {
    transform: none;
  }

  /* The film takes the picture's place and the picture's size rules: whole,
     centred, never larger than the field. */
  .full video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    background: #000;
