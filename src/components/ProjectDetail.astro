---
import Base from '../layouts/Base.astro';
import { loadProjects, pick, resolveProjectMeta, type Project } from '../db';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { projectPath, projectSchema } from '../seo/pages';

interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const t = useTranslations(locale);

const projects = loadProjects();
const index = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];

const altUrl = projectPath(locale === 'tr' ? 'en' : 'tr', project.slug);

/* The strip is a list now, not five fixed columns: it can be renamed,
   reordered, trimmed or extended per project (see db/projectMeta.ts). A row
   with no value prints nothing at all — an empty caption reads as missing
   data rather than as a field this project simply does not have. */
const meta = resolveProjectMeta(project)
  .map((row) => ({
    label: pick(row.label, locale) || (row.labelKey ? t(row.labelKey) : ''),
    value: pick(row.value, locale).trim(),
  }))
  .filter((row) => row.value);
---

<Base
  locale={locale}
  title={`${project.title} — Vono Studio`}
  description={project.excerpt[locale]}
  altUrl={altUrl}
  image={project.cover}
  type="article"
  schema={projectSchema(Astro.site!, locale, project)}
>
  <article class="detail">
    <div class="container">
      <a class="back" href={localePath(locale, '/#projeler')}>← {t('project.back')}</a>

      <header data-reveal>
        <h1>{project.title}</h1>
        <p class="excerpt">{project.excerpt[locale]}</p>
      </header>

      {
        meta.length > 0 && (
          <dl class="meta" data-reveal>
            {meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <figure class="cover" data-reveal>
      <img src={project.cover} alt={project.title} fetchpriority="high" decoding="async" />
    </figure>

    <div class="container body-grid">
      <div class="body" data-reveal>
        {project.body[locale].map((p) => <p>{p}</p>)}
      </div>
    </div>

    {
      project.gallery.length > 0 && (
        <div class="container gallery">
          {project.gallery.map((src, i) => (
            <figure data-reveal>
              <img src={src} alt={`${project.title} — ${i + 1}`} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      )
    }

    <nav class="pn container" aria-label="Projects">
      <a href={projectPath(locale, prev.slug)} rel="prev">
        <span>← {t('project.prev')}</span>
        <strong>{prev.title}</strong>
      </a>
      <a class="next" href={projectPath(locale, next.slug)} rel="next">
        <span>{t('project.next')} →</span>
        <strong>{next.title}</strong>
      </a>
    </nav>
  </article>
</Base>

<style>
  .detail {
    padding-top: calc(var(--nav-h) + clamp(2rem, 6vw, 5rem));
  }

  .back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    transition: color 0.25s ease;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 5.5rem);
  }

  .excerpt {
    max-width: 38rem;
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--muted);
  }

  /* The row count is content, not layout: a project may carry three fields or
     nine. `auto-fit` lays out however many there are and folds them onto more
     lines as the viewport narrows, so no breakpoint has to know the number.
     `min()` keeps a single column from overflowing a phone. */
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
    gap: 1.5rem clamp(1.25rem, 2.5vw, 2.5rem);
    border-top: 1px solid var(--line);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
  }

  .meta > div {
    min-width: 0;
  }

  .meta dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meta dd {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .cover {
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--soft);
  }

  .cover img {
    width: 100%;
    max-height: 82svh;
    object-fit: cover;
  }

  .body-grid {
    display: grid;
    grid-template-columns: 1fr minmax(0, 44rem) 1fr;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .body {
    grid-column: 2;
    display: grid;
    gap: 1.5rem;
    font-size: 1.05rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .gallery figure {
    background: var(--soft);
    overflow: hidden;
  }

  .gallery figure:first-child {
    grid-column: 1 / -1;
  }

  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
  }

  .pn {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .pn a {
    display: grid;
    gap: 0.4rem;
  }

  .pn a span {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pn a strong {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .pn a:hover strong {
    border-color: var(--ink);
  }

  .pn .next {
    text-align: right;
  }

  @media (max-width: 800px) {
    .meta {
      gap: 1.25rem;
    }
  }
</style>
