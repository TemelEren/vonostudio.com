---
import { useTranslations, type Locale } from '../i18n/ui';
import { loadAbout, loadSettings } from '../db';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const about = loadAbout();

const stats = loadSettings().stats.map((s) => ({ value: s.value, label: s.label[locale] }));

/* WARNING: ONE PARAGRAPH, NOT THE WHOLE STORY (editor, 2026-09-12: "make the
   about section simpler, nobody reads this much text"). The section used to
   print every intro paragraph, vision, mission, values, awards and the team -
   measured at 1440px it ran 2,300px tall. It is now the photo, the FIRST intro
   paragraph and the figures.

   The rest is NOT deleted: it stays in the content database and in the panel,
   so it can come back or move to a page of its own. The panel says what is not
   printed (§5.220). */
const lead = about.intro[locale][0] ?? '';
---

<section class="section" id="hakkimizda">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 class="section-title">{t('about.title')}</h2>
    </div>

    {/* WARNING: PICTURE LEFT, WORDS RIGHT (editor, 2026-09-12). The previous
        turn centred a single column; with one paragraph left, that column was
        mostly photo and a short line under it. Side by side, the paragraph and
        the figures sit next to the picture they describe and the section reads
        in one glance. On a phone the two stack again - photo first. */}
    <div class="about">
      <figure class="team-photo" data-reveal>
        <img src={about.photo} alt={t('about.photo.alt')} loading="lazy" decoding="async" />
      </figure>

      <div class="metin" data-reveal>
        {lead && <p class="lead">{lead}</p>}

        {
          stats.length > 0 && (
            <dl class="stats">
              {stats.map((s) => (
                <div>
                  <dt>{s.value}</dt>
                  <dd>{s.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* WARNING: THE TEXT STARTS ON THE PHOTO'S TOP EDGE, NOT ON ITS MIDDLE (editor,
     2026-09-12: "the text to the right of the photo, on the same line as the
     photo"). `align-items: center` centred the text block against the picture,
     so the two top edges drifted apart whenever the paragraph was shorter or
     longer than the photo. Both columns now stretch to the row: the paragraph
     begins where the picture begins and, when the picture is the taller of the
     two, the figures sit on its bottom edge. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: stretch;
  }

  /* WARNING: THE PHOTO KEEPS ITS OWN SHAPE - IT IS NOT STRETCHED TO THE TEXT.
     Tried and measured: stretching the figure to the row with `object-fit: cover`
     lined up the bottom edges too, but the photo is wide (2032x934) and below
     ~1300px the crop cut the second team member out of the frame at 1024px. An
     aligned bottom edge is not worth a missing person. So only the TOP edges are
     guaranteed; when the photo is the taller of the two (>=1440px) the figures
     still land on its bottom edge through `align-content: space-between`.

     WARNING: `aspect-ratio` ON A STRETCHED FIGURE IS A TRAP: the browser derived
     the width from the stretched height and the photo grew to 782px inside a
     468px column, covering the text (measured). The figure sits on the top edge
     and never stretches, so the grey loading background cannot show under it. */
  .team-photo {
    background: var(--soft);
    align-self: start;
    min-width: 0;
  }

  .team-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 2032 / 934;
    object-fit: cover;
  }

  .metin {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
    align-content: space-between;
  }

  /* The line box adds half the leading above the first line, so the letters
     would start visibly below the photo's top edge. The negative margin takes
     that half-leading back: (1.5 - 1) / 2 = 0.25em. */
  .lead {
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    line-height: 1.5;
    margin-top: -0.25em;
  }

  /* The figures take as many columns as fit: four in a wide text column, two
     when it is narrow - never a single column of numbers. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
  }

  .stats dt {
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .stats dd {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.4rem;
  }

  @media (max-width: 800px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
