---
import { services, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const list = services();
---

<section class="section" id="hizmetler">
  <div class="container">
    {t('services.title') && (
      <div class="section-head" data-reveal>
        <h2 class="section-title">{t('services.title')}</h2>
      </div>
    )}

    <ul class="services">
      {
        list.map((s, i) => (
          <li data-reveal>
            <span class="index">0{i + 1}</span>
            <h3>{s.title[locale]}</h3>
            <p>{s.desc[locale]}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* WARNING: THE ROW SPANS THE PROJECT GRID, AND THE WORDS DO THE BALANCING
     (editor, 2026-09-12). Two tries at closing the gap by narrowing the title
     column (a bounded 20rem, then a fit-content subgrid) left the list hugging
     the left edge and ending far short of the project grid above - "narrow and
     shapeless". The row is full width again, as it was, so its right edge is
     the grid's right edge. What changed is the proportion: the description
     column is wider than the title column and its type larger, so the text
     fills the row instead of hanging at its far end. */
  .services {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .services li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.35fr);
    align-items: center;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) 1rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.35s ease, color 0.35s ease, padding-left 0.35s ease;
  }

  .services li:hover {
    background: var(--ink);
    color: var(--bg);
    padding-left: 2rem;
  }

  .index {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--muted);
    transition: color 0.35s ease;
  }

  .services li:hover .index {
    color: color-mix(in srgb, var(--bg) 60%, transparent);
  }

  .services h3 {
    font-size: var(--t-item);
  }

  .services p {
    font-size: clamp(0.98rem, 1.2vw, 1.15rem);
    line-height: 1.55;
    color: var(--muted);
    transition: color 0.35s ease;
  }

  .services li:hover p {
    color: color-mix(in srgb, var(--bg) 75%, transparent);
  }

  @media (max-width: 800px) {
    .services li {
      grid-template-columns: 2.5rem 1fr;
    }

    .services p {
      grid-column: 2;
    }
  }
</style>
