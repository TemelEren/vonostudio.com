---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import References from '../components/References.astro';
import Contact from '../components/Contact.astro';
import { useTranslations, localePath } from '../i18n/ui';
import { loadSectionOrder, type SectionKey } from '../db';
import { homeSchema } from '../seo/pages';

const locale = 'tr' as const;
const t = useTranslations(locale);

/* The stacking order is the editor's (db/sectionOrder.ts). Intro is not in the
   list: it is the page opening - the logo animation ends by flying into the nav
   - so it has nowhere else to be. */
const BOLUM: Record<SectionKey, typeof Projects> = {
  projects: Projects,
  services: Services,
  about: About,
  references: References,
  contact: Contact,
};
const sira = loadSectionOrder();
---

<Base
  locale={locale}
  title={t('meta.title')}
  description={t('meta.description')}
  altUrl={localePath('en', '/')}
  schema={homeSchema(Astro.site!, locale)}
>
  <Intro />
  {
    sira.map((k) => {
      const Bolum = BOLUM[k];
      return <Bolum locale={locale} />;
    })
  }
</Base>
