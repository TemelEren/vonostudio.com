---
/* Every family the theme may choose (db/theme.ts -> FONTS).

   WARNING: IMPORTING A FAMILY DOES NOT DOWNLOAD IT. These are @font-face
   declarations; a browser fetches the woff2 only for a family the page
   actually renders with. So the visitor still downloads TWO faces - the two
   the theme selected - and the cost of offering the rest is a few KB of CSS.
   WARNING: A FAMILY IN THE CATALOGUE MUST BE IMPORTED HERE. Choosing one that
   is not renders in the fallback with nothing to explain why. */
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/manrope';
import '@fontsource-variable/archivo';
import '@fontsource-variable/syne';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/lora';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PreviewInspect from '../components/PreviewInspect.astro';
import { loadSettings, loadTheme, themeCss } from '../db';
import { withBase, type Locale } from '../i18n/ui';
import { graph } from '../seo/schema';
import { isProductionSite } from '../seo/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** URL of the same page in the other locale. */
  altUrl: string;
  /** Social share image, root-relative. Defaults to settings.seo.ogImage. */
  image?: string;
  /** og:type — 'article' for project pages. */
  type?: 'website' | 'article';
  /** Extra schema.org nodes this page contributes to the JSON-LD @graph. */
  schema?: unknown[];
  /** Keep this page out of search results (used by 404). */
  noindex?: boolean;
}
const settings = loadSettings();
/* The editable look. A database with no theme row resolves to the design the
   site shipped with, so this is safe on every existing install. */
const theme = loadTheme();
const {
  locale,
  title,
  description,
  altUrl,
  image = settings.seo.ogImage,
  type = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

const site = Astro.site!;
// Preview domains are never indexed, whatever the page asks for.
/* WARNING: A PREVIEW IS NEVER INDEXED. Preview domains were already covered
   by isProductionSite, but the draft can also be previewed ON the production
   domain - and that page must not reach search results. */
const preview = Astro.locals.preview === true;
const blockIndexing = noindex || preview || !isProductionSite(site);
const canonical = new URL(Astro.url.pathname, site);
const altLocale: Locale = locale === 'tr' ? 'en' : 'tr';
const altHref = new URL(altUrl, site);
const ogImage = new URL(image, site);
// The Turkish pages are the default locale, so they double as x-default.
const defaultHref = locale === 'tr' ? canonical : altHref;
const jsonLd = graph(site, locale, schema);
---

<!doctype html>
<html lang={locale === 'tr' ? 'tr-TR' : 'en-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {blockIndexing && <meta name="robots" content="noindex, follow" />}
    {
      !blockIndexing && (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={altLocale} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={defaultHref} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101010" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={altLocale === 'tr' ? 'tr_TR' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <script is:inline>
      // Marks JS availability so animation-ready elements can start hidden.
      document.documentElement.classList.add('js');
    </script>
    {/* ⚠ LAST IN HEAD ON PURPOSE: these are :root custom properties, the same
        specificity as global.css, so ORDER is what makes them win. Moving this
        above the bundled stylesheet would silently restore the old palette. */}
    <style set:html={themeCss(theme)} />
  </head>
  <body>
    {
      /* Shown only while previewing the unpublished draft. It is deliberately
         part of the page and not an overlay the panel adds: someone who opens
         the preview link in its own tab must still be able to tell at a glance
         that this is not the live site. */
      preview && (
        <div class="onizleme-serit">
          TASLAK ÖNİZLEME — bu sayfa yayında değildir
        </div>
      )
    }
    <a class="skip-link" href="#main">{locale === 'tr' ? 'İçeriğe geç' : 'Skip to content'}</a>
    <Nav locale={locale} altUrl={altUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    {
      /* Lets the editing panel point at a sentence in this page. Preview
         only - the public site never carries a message listener. */
      preview && <PreviewInspect locale={locale} />
    }

    <script>
      const items = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' }
      );
      items.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  /* Preview banner. `is:global` because the banner is rendered by the layout
     but must stay above every component's own stacking context. */
  .onizleme-serit {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 9999;
    background: #b45309;
    color: #fff;
    font: 600 0.75rem/1 var(--font-body, system-ui), sans-serif;
    letter-spacing: 0.08em;
    text-align: center;
    padding: 0.5rem 1rem;
  }
  body:has(.onizleme-serit) { padding-top: 2rem; }
</style>
