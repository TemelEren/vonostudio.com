# Bu dosyayı .env olarak kopyalayın ve sunucuya göre düzenleyin.

# Sitenin yayınlandığı adres. Canonical adresler, hreflang, site haritası ve
# sosyal paylaşım kartları bundan üretilir ve DERLEME ZAMANINDA gömülür:
# değiştirdikten sonra "docker compose up -d --build" gerekir.
# vonostudio.com dışındaki her adres otomatik olarak aramaya kapalı yayınlanır.
SITE_URL=https://next.vonostudio.com

# Sunucuda dinlenecek port ve adres. HAProxy aynı makinedeyse 127.0.0.1 bırakın.
PORT=8081
BIND_ADDRESS=127.0.0.1

# content.db dosyasının durduğu KLASÖR (compose.yaml'a göre göreli yol).
# Klasör mount edilir, dosya değil — nedeni için README'ye bakın.
DB_DIR=./data

# Konteynerin çalıştığı kullanıcı; DB_DIR klasörünün sahibiyle aynı olmalı.
# Sunucuda "id -u":"id -g" çıktısını yazın, ör. RUN_AS=1000:1000
RUN_AS=1000:1000
